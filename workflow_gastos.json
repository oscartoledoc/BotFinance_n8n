      "parameters": {
        "jsCode": "// Obtenemos el mensaje que llegó de Telegram\nconst mensaje = $('Telegram Trigger').first().json.message.text;\nconst usuario = $('Telegram Trigger').first().json.message.from.first_name;\n\n// Lógica para separar \"Hamburguesa 25\"\n// 1. Dividimos el texto por espacios\nconst partes = mensaje.split(\" \");\n\n// 2. Sacamos la última parte (el supuesto precio)\nconst posibleMonto = partes.pop(); \n\n// 3. Lo que queda es la descripción\nconst descripcion = partes.join(\" \");\n\n// 4. Devolvemos los datos limpios\nreturn {\n  json: {\n    fecha: new Date().toLocaleDateString('es-PE'), // Fecha de hoy\n    concepto: descripcion || \"Sin concepto\",\n    monto: parseFloat(posibleMonto) || 0, // Convertimos a número\n    usuario: usuario\n  }\n};"
      },
